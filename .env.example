# =============================================================================
# AI KNOWLEDGE PLATFORM — Environment Variables
# Copy to .env and fill in values. Never commit .env to git.
# =============================================================================

# --- Application ---
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# --- Database (PostgreSQL + pgvector) ---
DATABASE_URL=postgresql+asyncpg://aiplatform:aiplatform@localhost:5432/aiplatform
ALEMBIC_DATABASE_URL=postgresql://aiplatform:aiplatform@localhost:5432/aiplatform
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# --- LLM Provider Selection ---
LLM_PROVIDER=openai
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_CHAT_MODEL=claude-haiku-4-5-20251001

# --- AWS ---
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
S3_BUCKET_NAME=ai-platform-documents-dev
S3_PREFIX=raw/

# --- Ingestion ---
CHUNK_SIZE=800
CHUNK_OVERLAP=100
MAX_CHUNKS_PER_DOC=500
HASH_ALGORITHM=sha256

# --- Retrieval ---
RETRIEVAL_TOP_K=5
RETRIEVAL_SIMILARITY_THRESHOLD=0.75

# --- Cost Controls ---
MAX_LLM_CALLS_PER_RUN=100
MAX_EMBEDDING_CALLS_PER_RUN=1000
# Global daily cap (UTC day) on LLM requests from unauthenticated public endpoints
PUBLIC_DAILY_LLM_LIMIT=150
LLM_CACHE_ENABLED=true

# --- RAG Demo App ---
RAG_DEMO_PORT=8000
RAG_DEMO_TITLE=AI Knowledge Platform — Public RAG Demo
