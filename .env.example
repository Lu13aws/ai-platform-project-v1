# =============================================================================
# AI KNOWLEDGE PLATFORM — Environment Variables
# Copy to .env and fill in values. Never commit .env to git.
# =============================================================================

# --- Application ---
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# --- Database (PostgreSQL + pgvector) ---
DATABASE_URL=postgresql+asyncpg://aiplatform:aiplatform@localhost:5432/aiplatform
ALEMBIC_DATABASE_URL=postgresql://aiplatform:aiplatform@localhost:5432/aiplatform
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# --- LLM Provider Selection ---
LLM_PROVIDER=openai
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_CHAT_MODEL=claude-haiku-4-5-20251001

# --- AWS ---
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
S3_BUCKET_NAME=ai-platform-documents-dev
S3_PREFIX=raw/

# --- Ingestion ---
CHUNK_SIZE=800
CHUNK_OVERLAP=100
MAX_CHUNKS_PER_DOC=500
HASH_ALGORITHM=sha256

# --- Retrieval ---
RETRIEVAL_TOP_K=5
RETRIEVAL_SIMILARITY_THRESHOLD=0.75

# --- Cost Controls ---
MAX_LLM_CALLS_PER_RUN=100
MAX_EMBEDDING_CALLS_PER_RUN=1000
# Global daily cap (UTC day) on LLM requests from unauthenticated public endpoints
PUBLIC_DAILY_LLM_LIMIT=150
LLM_CACHE_ENABLED=true

# --- RAG Demo App ---
RAG_DEMO_PORT=8000
RAG_DEMO_TITLE=AI Knowledge Platform — Public RAG Demo

# --- Deploy / setup scripts (scripts/_aws.py) -------------------------------------------------
# The AWS account id is resolved via STS and VPC/subnet/security-group ids come from
# infra/vpc_config.json (written by scripts/setup_vpc.py), so neither belongs here.
PLATFORM_COGNITO_USER_POOL_ID=<COGNITO_USER_POOL_ID>
PLATFORM_COGNITO_CLIENT_ID=<COGNITO_CLIENT_ID>
CORP_COGNITO_USER_POOL_ID=<CORP_COGNITO_USER_POOL_ID>
CORP_COGNITO_CLIENT_ID=<CORP_COGNITO_CLIENT_ID>
PLATFORM_ACM_CERT_ARN=arn:aws:acm:us-east-1:<AWS_ACCOUNT_ID>:certificate/<CERT_ID>
API_BASE=https://<API_ID>.execute-api.eu-central-1.amazonaws.com
CORP_API_BASE=https://<CORP_API_ID>.execute-api.eu-central-1.amazonaws.com
CORP_ADMIN_EMAIL=<OWNER_EMAIL>
# Local-only private knowledge hub (apps/private_hub): folder to ingest
PRIVATE_HUB_DIR=./private-knowledge-hub
