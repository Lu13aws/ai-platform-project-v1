.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets — never bake into image
.env
.env.*

# Local data
data/
docker/

# Docs and scripts not needed at runtime
docs/
research/
scripts/
tests/
notebooks/

# Next.js UI: built and deployed by GitHub Actions (S3/CloudFront), never runs in Lambda.
# Without this, node_modules + .next add ~900 MB to every Lambda image.
apps/knowledge_platform_ui/
**/node_modules/
**/.next/

# Git
.git/
.gitignore

# IDE
.idea/
.vscode/
