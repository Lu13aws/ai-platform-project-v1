FROM public.ecr.aws/lambda/python:3.12

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Install dependencies into Lambda task root
WORKDIR /build
COPY pyproject.toml uv.lock ./
RUN uv export --frozen --no-dev --no-hashes > requirements.txt && \
    pip install -r requirements.txt -t ${LAMBDA_TASK_ROOT} --quiet

# Copy application source
WORKDIR ${LAMBDA_TASK_ROOT}
COPY aiplatform/ ./aiplatform/
COPY apps/ ./apps/

CMD ["apps.rag_demo.lambda_handler.handler"]
